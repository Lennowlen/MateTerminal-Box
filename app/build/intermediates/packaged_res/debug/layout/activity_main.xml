<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_primary"
    android:baselineAligned="false">

    <!-- Left Tablet Sidebar (Hosts, Telemetry HUD Toggle, Snippets) -->
    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_sidebar"
        android:padding="12dp">

        <!-- App Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_app_launcher"
                android:contentDescription="Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MateTerminal-Box"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MatePad 12X Pro Edition"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnAddHost"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/accent_cyan"
                android:contentDescription="Add Host" />
        </LinearLayout>

        <!-- Segmented Mode Navigation: Terminal / ServerBox Monitor / Snippets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="@color/bg_secondary"
            android:layout_marginBottom="12dp"
            android:padding="2dp">

            <Button
                android:id="@+id/btnNavHosts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Hosts"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/bg_card"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <Button
                android:id="@+id/btnNavMonitor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="ServerBox"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@android:color/transparent"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnNavSnippets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text="Snippets"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@android:color/transparent"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>

        <!-- Saved Host Profiles List -->
        <TextView
            android:id="@+id/tvListHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAVED SESSIONS"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHosts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <!-- Footer: Battery / Network status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MatePad 12X (3:2 144Hz)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvKeepaliveIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KEEPALIVE ON"
                android:textColor="@color/accent_emerald"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/border_color" />

    <!-- Right Tablet Workspace (Tabs + Multi-Pane Terminal + ServerBox HUD + Accessory Keybar) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top Tab Bar & Window Split Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@color/bg_secondary"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <!-- Horizontal Tab Scroll -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- New Tab Action -->
            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/text_secondary"
                android:contentDescription="New Tab" />

            <!-- Split Screen Options (1x1, 1x2, 2x2) -->
            <Button
                android:id="@+id/btnSplitMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Split 1x2"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/bg_card"
                android:layout_marginStart="8dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
        </LinearLayout>

        <!-- Main Workspace Frame (Switches between Terminal View and ServerBox HUD) -->
        <FrameLayout
            android:id="@+id/workspaceFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Terminal Multi-Pane Layout Container -->
            <LinearLayout
                android:id="@+id/terminalSplitLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Left / Primary Terminal Pane -->
                <LinearLayout
                    android:id="@+id/paneLeft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/bg_terminal"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvTerminalOutput1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:scrollbars="vertical" />
                </LinearLayout>

                <!-- Optional Right / Secondary Terminal Pane (for Split 1x2) -->
                <LinearLayout
                    android:id="@+id/paneRight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/bg_terminal"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvTerminalOutput2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:scrollbars="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ServerBox Live Telemetry HUD Overlay -->
            <ScrollView
                android:id="@+id/serverBoxHudView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_primary"
                android:visibility="gone"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ServerBox Live Telemetry"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvServerBoxHostName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Host: Production VPS (Singapore)"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:paddingBottom="16dp" />

                    <!-- Metrics Grid (CPU, RAM, Disk, Net) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- CPU Metric Card -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="8dp"
                            app:cardBackgroundColor="@color/bg_card">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CPU LOAD"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvCpuPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="24.5%"
                                    android:textColor="@color/accent_cyan"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <ProgressBar
                                    android:id="@+id/pbCpu"
                                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:progress="25"
                                    android:progressTint="@color/accent_cyan" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- RAM Metric Card -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="8dp"
                            app:cardBackgroundColor="@color/bg_card">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MEMORY &amp; SWAP"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMemPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3.8 GB / 8.0 GB (47%)"
                                    android:textColor="@color/accent_emerald"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <ProgressBar
                                    android:id="@+id/pbMem"
                                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:progress="47"
                                    android:progressTint="@color/accent_emerald" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Network I/O Metric Card -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="8dp"
                            app:cardBackgroundColor="@color/bg_card">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NETWORK TRAFFIC"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvNetSpeed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="RX: 1.4 MB/s | TX: 240 KB/s"
                                    android:textColor="@color/accent_amber"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvUptime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Uptime: 48 days, 14 hours"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp"
                                    android:paddingTop="4dp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Bottom Keyboard Accessory Toolbar (Esc, Tab, Ctrl, Alt, Pipe, Arrow Keys) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_sidebar"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp">

                <Button android:id="@+id/keyEsc" android:layout_width="54dp" android:layout_height="32dp" android:text="ESC" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyTab" android:layout_width="54dp" android:layout_height="32dp" android:text="TAB" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyCtrl" android:layout_width="54dp" android:layout_height="32dp" android:text="CTRL" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyAlt" android:layout_width="54dp" android:layout_height="32dp" android:text="ALT" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyPipe" android:layout_width="44dp" android:layout_height="32dp" android:text="|" android:textSize="11sp" android:textColor="@color/accent_cyan" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyTilde" android:layout_width="44dp" android:layout_height="32dp" android:text="~" android:textSize="11sp" android:textColor="@color/accent_cyan" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keySlash" android:layout_width="44dp" android:layout_height="32dp" android:text="/" android:textSize="11sp" android:textColor="@color/accent_cyan" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyHyphen" android:layout_width="44dp" android:layout_height="32dp" android:text="-" android:textSize="11sp" android:textColor="@color/accent_cyan" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyUp" android:layout_width="44dp" android:layout_height="32dp" android:text="UP" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyDown" android:layout_width="44dp" android:layout_height="32dp" android:text="DN" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyLeft" android:layout_width="44dp" android:layout_height="32dp" android:text="LT" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:id="@+id/keyRight" android:layout_width="44dp" android:layout_height="32dp" android:text="RT" android:textSize="10sp" android:textColor="@color/text_primary" android:backgroundTint="@color/bg_secondary" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
